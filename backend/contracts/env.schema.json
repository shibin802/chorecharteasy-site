{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChoreChartEasy Backend Environment Contract",
  "type": "object",
  "required": ["PUBLIC_ORIGIN", "AUTH_ENABLED", "EARLY_ACCESS_ENABLED", "PAYMENTS_ENABLED"],
  "properties": {
    "DB": {
      "type": "d1_binding",
      "description": "Cloudflare D1 binding named DB"
    },
    "PUBLIC_ORIGIN": {
      "type": "string",
      "format": "uri",
      "examples": ["https://chorecharteasy.com"]
    },
    "AUTH_ENABLED": {
      "type": "string",
      "enum": ["true", "false"],
      "default": "false"
    },
    "AUTH_DEV_BYPASS": {
      "type": "string",
      "enum": ["true", "false"],
      "default": "false",
      "description": "Only returns a debug magic-link token on loopback hosts"
    },
    "EARLY_ACCESS_ENABLED": {
      "type": "string",
      "enum": ["true", "false"],
      "default": "false"
    },
    "PAYMENTS_ENABLED": {
      "type": "string",
      "enum": ["true", "false"],
      "default": "false"
    },
    "STRIPE_SECRET_KEY": {
      "type": "string",
      "minLength": 24,
      "secret": true,
      "description": "Stripe server-side secret or restricted key with Checkout Sessions access"
    },
    "STRIPE_PRICE_ID": {
      "type": "string",
      "pattern": "^price_[A-Za-z0-9]+$",
      "description": "One-time USD 4.99 Price for the Plus Starter Pack"
    },
    "SESSION_SECRET": {
      "type": "string",
      "minLength": 32,
      "secret": true
    },
    "RATE_LIMIT_SALT": {
      "type": "string",
      "minLength": 32,
      "secret": true
    },
    "SESSION_TTL_SECONDS": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "default": "2592000"
    },
    "MAGIC_LINK_TTL_SECONDS": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "default": "900"
    }
  },
  "additionalProperties": true
}
