{
  "version": "v1",
  "status": "example_only_not_deployed",
  "cloudflarePages": {
    "project": "chorecharteasy",
    "functionsDirectory": "functions/",
    "productionBranch": "main"
  },
  "bindings": {
    "d1": [
      {
        "binding": "DB",
        "databaseName": "[CREATE_AND_CONFIRM]",
        "databaseId": "[SET_IN_CLOUDFLARE_NOT_HERE]",
        "environments": ["preview", "production"]
      }
    ],
    "r2": []
  },
  "plainVariables": {
    "PUBLIC_ORIGIN": "https://chorecharteasy.com",
    "AUTH_ENABLED": "false",
    "AUTH_DEV_BYPASS": "false",
    "AUTH_FROM_EMAIL": "ChoreChartEasy <login@chorecharteasy.com>",
    "EARLY_ACCESS_ENABLED": "false",
    "PAYMENTS_ENABLED": "false",
    "SESSION_TTL_SECONDS": "2592000",
    "MAGIC_LINK_TTL_SECONDS": "900"
  },
  "secrets": [
    {
      "name": "SESSION_SECRET",
      "requiredWhen": "AUTH_ENABLED=true",
      "minimumBytes": 32
    },
    {
      "name": "RATE_LIMIT_SALT",
      "requiredWhen": "AUTH_ENABLED=true or EARLY_ACCESS_ENABLED=true",
      "minimumBytes": 32
    },
    {
      "name": "RESEND_API_KEY",
      "requiredWhen": "AUTH_ENABLED=true outside loopback development",
      "minimumBytes": 20
    }
  ],
  "hardBlocks": [
    "Do not set AUTH_DEV_BYPASS=true outside loopback development.",
    "Do not enable auth until the Resend sender domain and legal disclosure are reviewed.",
    "Do not enable early access until consent copy, unsubscribe, deletion, and retention are approved.",
    "Do not add payment endpoints until the paid-interest gate and payment lifecycle review pass."
  ]
}
